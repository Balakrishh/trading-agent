# Quality-at-lows sleeve shadow scan — one shot, started by
# trading-agent-quality-lows.timer (skill 67). Bars and analyst estimates
# from Yahoo; fundamentals and chains from the local data server, never
# its own Schwab session. Records only — places no orders.
[Unit]
Description=Trading agent quality-at-lows shadow scan
After=trading-agent-data-server.service

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/trading-agent
ExecStart=%h/Documents/trading-agent/myenv/bin/python -m trading_agent.quality_lows
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:/tmp/trading-agent.quality-lows.out.log
StandardError=append:/tmp/trading-agent.quality-lows.err.log
