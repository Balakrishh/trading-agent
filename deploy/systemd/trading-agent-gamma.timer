# 16:05 ET on weekdays: the agent has stopped for the day (Schwab's rate
# budget is free) and SPY / QQQ / IWM options still trade until 16:15, so
# quotes and IVs are live. Holidays exit without recording.
[Unit]
Description=Record dealer gamma at 16:05 ET on weekdays

[Timer]
OnCalendar=Mon..Fri 16:05 America/New_York
Persistent=true

[Install]
WantedBy=timers.target
