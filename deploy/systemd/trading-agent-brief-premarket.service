# Session brief — one shot, started by trading-agent-brief-premarket.timer
# (skill 71). Reads the data server and the agent's own files; sends one
# Telegram message; never places or stages an order.
[Unit]
Description=Trading agent pre-market brief
After=trading-agent-data-server.service

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/trading-agent
ExecStart=%h/Documents/trading-agent/myenv/bin/python -m trading_agent.session_brief premarket
Environment=PYTHONUNBUFFERED=1
StandardOutput=append:/tmp/trading-agent.brief-premarket.out.log
StandardError=append:/tmp/trading-agent.brief-premarket.err.log
